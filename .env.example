# Copie para .env.local (que o git ignora) e ajuste se a porta mudar.
# O compose de desenvolvimento sobe o Postgres em 55432:
#   docker compose up -d
DATABASE_URL=postgres://test:test@localhost:55432/test

# Login do admin (AUTH-08): o seed cria o primeiro administrador com estas
# credenciais. Gere um AUTH_SECRET novo (32+ bytes) para cada ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-um-segredo-de-32-bytes-ou-mais
ADMIN_EMAIL=admin@yoguese.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
